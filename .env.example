# === AI PROVIDERS ===
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# === NOTION ===
NOTION_API_KEY=your_notion_integration_token_here
NOTION_DATABASE_ID=your_generated_scripts_database_id_here
NOTION_ANGELLOS_CONTEXT_DB=your_angellos_context_database_id_here
NOTION_ANGELLOS_RESULTS_DB=your_angellos_results_database_id_here

# === APIFY (Instagram scraping) ===
APIFY_API_KEY=your_apify_api_key_here

# === INSTAGRAM API (optional — for official stats sync) ===
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here
INSTAGRAM_ACCOUNT_ID=me

# === CORS (comma-separated list of allowed frontend origins) ===
CORS_ALLOWED_ORIGINS=https://angellos-content-dashboard.vercel.app

# === PIPELINE CONFIG ===
DOWNLOADS_DIR=./downloads
MAX_REELS_PER_ACCOUNT=10
